; Copy to nm.zone. These names are the hub's mesh address.
; Bump the serial after every change.
$ORIGIN nm.
$TTL 300
@       IN SOA  ns.nm. hostmaster.nm. (
                2026103103
                7200
                3600
                1209600
                300 )
        IN NS   ns
ns      IN A    100.64.0.1
hub     IN A    100.64.0.1
square  IN A    100.64.0.1
