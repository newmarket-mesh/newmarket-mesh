# Copy to .env in this directory. Never commit .env.

# This host's LAN address, in addition to 127.0.0.1.
# A browser on another machine on the same LAN opens http://LAB_BIND:8090/
# Do not forward these ports on your router.
LAB_BIND=
LAB_HTTP_PORT=8090

# Newmarket Square (Lemmy). Hex keeps the values safe inside the config.
# The admin password is read on the first start only, 10 to 60 characters.
#   openssl rand -hex 20   for SQUARE_ADMIN_PASS
#   openssl rand -hex 32   for the other two
SQUARE_ADMIN_USER=operator
SQUARE_ADMIN_PASS=
SQUARE_DB_PASS=
SQUARE_PICTRS_KEY=
